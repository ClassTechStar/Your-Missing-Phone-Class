# Python 工具链产生的临时物
__pycache__/
*.py[cod]
*.egg-info/

# 构建与发布产物（由 bookkit build / release 生成）
dist/

# 覆盖率报告由 CI 产出并作为 artifact 上传
coverage.md

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# LaTeX 构建中间产物（main.tex 与 chapters/ 是源稿，需入库）
latex/*.aux
latex/*.log
latex/*.toc
latex/*.out
latex/*.lof
latex/*.lot
latex/*.pdf
latex/*.txt
latex/smoke*

# 各语言 LaTeX 产物目录（bookkit latex --out latex/<lang> 生成，体积大不入库；
# 只保留根目录 latex/ 的 zh 源稿与产物）
latex/*/
scripts/_*.py
