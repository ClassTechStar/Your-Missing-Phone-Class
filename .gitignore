# Python 工具链产生的临时物
__pycache__/
*.py[cod]
*.egg-info/

# 构建与发布产物（由 bookkit build / release 生成）
dist/

# 覆盖率报告由 CI 产出并作为 artifact 上传
coverage.md

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# LaTeX 构建中间产物（main.tex 与 chapters/ 是源稿，需入库）
latex/*.aux
latex/*.log
latex/*.toc
latex/*.out
latex/*.lof
latex/*.lot
latex/*.pdf
latex/*.txt
latex/smoke*

# 脚本临时文件
scripts/_*.py

# 各语言 LaTeX 编译瞬态（保留 main.tex/.toc/.pdf 与 chapters/ figures/）
latex/*/main.aux
latex/*/main.log
latex/*/main.out
latex/*/pass*.log

# LaTeX-PDF 排版管线（仓库内副本）：脚本入库，大资产与中间物不入库
# （成品 PDF 走 GitHub Releases：latex-pdf-v1.5 ~ latex-pdf-v1.8-final）
手机课-LaTeX-PDF/pdf/
手机课-LaTeX-PDF/work/
手机课-LaTeX-PDF/render-*/
手机课-LaTeX-PDF/fonttest/
手机课-LaTeX-PDF/fonts/
